# Browser-safe Neon Auth endpoint. This is not a database connection string.
VITE_NEON_AUTH_URL=https://your-neon-auth-host.example/neondb/auth

# Server-only pooled connection for Vercel Functions / Drizzle.
DATABASE_URL=postgresql://app_role:password@your-neon-host/neondb?sslmode=require

# Server/admin connection used only from a trusted local/CI migration job.
# Do not add this variable to the browser and normally do not add it to Vercel runtime.
MIGRATION_DATABASE_URL=postgresql://migration_owner:password@your-neon-host/neondb?sslmode=require

# Server-only JWT verification settings. Copy the exact JWKS URL shown under
# Neon Auth -> Configuration; do not derive or guess its .well-known path.
NEON_AUTH_JWKS_URL=https://copy-the-exact-jwks-url-from-neon-console

# Optional until the exact `iss` claim has been confirmed from a development JWT.
# NEON_AUTH_ISSUER=https://your-neon-auth-host.example/neondb/auth

# Optional. Set only if the issued JWT contains and requires a specific audience.
# NEON_AUTH_AUDIENCE=your-audience
